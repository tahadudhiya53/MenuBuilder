{# Optional recursive renderer. #}
{#
   The navigation landmark: one `<nav>` per menu, named after the menu, with the menu's own CSS
   class and (safe) HTML attributes on it.
#}
{% macro renderNav(menu, label = null, disclosure = 'details', idPrefix = '', viewport = 'both') %}
    {% import _self as self %}
    {% if menu is not empty %}
        <nav class="{{ menu.group.cssClass }}"
             aria-label="{{ label ?: menu.group.name }}"
             data-menu-builder-nav
             {%- if viewport != 'both' %} data-mb-viewport="{{ viewport }}"{% endif %}
             {%- for key, value in menu.group.safeHtmlAttributes() %} {{ key }}="{{ value }}"{% endfor %}>
            {{ self.render(menu.items, disclosure, idPrefix, viewport) }}
        </nav>
    {% endif %}
{% endmacro %}

{#
   Optional mega-menu renderer for one node whose `megaMenu` is set (see MenuBuilderNode::$megaMenu
   / ::megaMenuColumns()).
#}
{% macro renderMegaMenu(node, disclosure = 'details', idPrefix = '', viewport = 'both') %}
    {% import _self as self %}
    {#
       On mobile a mega menu is not a mega menu: a multi-column panel on a 390px screen is one
       column with a horizontal scrollbar.
    #}
    {% set megaBehavior = viewport == 'mobile' ? node.mobileMegaMenuBehavior() : 'columns' %}
    {# Nothing to disclose, nothing to render. #}
    {% if not node.hasChildren() or megaBehavior == 'hide' %}
    {% elseif viewport == 'mobile' and disclosure != 'none' %}
        {#
           In the mobile navigation a mega menu is one more collapsible branch, disclosed exactly
           like any other — same <details>, same summary naming, so a drawer has one interaction
           and not two.
        #}
        {{ self.mobileSubmenu(node, megaBehavior == 'columns' ? self.megaMenuPanel(node, disclosure, idPrefix, viewport) : self.render(node.children, disclosure, idPrefix, viewport)) }}
    {% elseif viewport == 'mobile' %}
        {# `disclosure: 'none'` still means what it says on mobile: no state claimed, panel in flow. #}
        {% if megaBehavior == 'columns' %}{{ self.megaMenuPanel(node, disclosure, idPrefix, viewport) }}{% else %}{{ self.render(node.children, disclosure, idPrefix, viewport) }}{% endif %}
    {% elseif disclosure == 'none' %}
        {{ self.megaMenuPanel(node, disclosure, idPrefix, viewport) }}
    {% else %}
        <details class="menu-builder-megamenu" data-mb-disclosure>
            <summary class="menu-builder-megamenu-trigger"
                     aria-label="{{ "{title} submenu"|t('menu-builder', { title: node.ariaLabel ?: node.title }) }}">
                <span class="menu-builder-megamenu-caret" aria-hidden="true">&#9662;</span>
            </summary>
            {{ self.megaMenuPanel(node, disclosure, idPrefix, viewport) }}
        </details>
    {% endif %}
{% endmacro %}

{# One collapsible branch in the mobile navigation: the children, behind a native `<details>`. #}
{% macro mobileSubmenu(node, children) %}
    <details class="menu-builder-submenu" data-mb-submenu>
        <summary class="menu-builder-submenu-trigger"
                 aria-label="{{ "{title} submenu"|t('menu-builder', { title: node.ariaLabel ?: node.title }) }}">
            <span class="menu-builder-submenu-caret" aria-hidden="true">&#9662;</span>
        </summary>
        {{ children }}
    </details>
{% endmacro %}

{# The panel itself — one <ul> per used column, grouped and named after the item. #}
{% macro megaMenuPanel(node, disclosure, idPrefix = '', viewport = 'both') %}
    {% import _self as self %}
    <div id="menu-builder-megamenu-{{ idPrefix ? idPrefix ~ '-' : '' }}{{ node.id }}"
         class="menu-builder-megamenu-panel{{ disclosure == 'none' ? ' menu-builder-megamenu-panel--static' : '' }}"
         role="group"
         aria-label="{{ node.ariaLabel ?: node.title }}">
        {% for column, columnNodes in node.megaMenuColumns() %}
            <div class="menu-builder-megamenu-column">
                {{ self.render(columnNodes, disclosure, idPrefix, viewport) }}
            </div>
        {% endfor %}
    </div>
{% endmacro %}

{# Renders one node's icon, if it has one. #}
{% macro icon(node) %}
    {% if node.iconType() == 'class' %}
        <span class="menu-builder-icon {{ node.iconClass() }}" aria-hidden="true"></span>
    {% elseif node.iconType() == 'asset' %}
        {% set iconAsset = craft.menuBuilder.iconAsset(node) %}
        {% if iconAsset %}
            <img class="menu-builder-icon" src="{{ iconAsset.url }}" alt="" width="{{ iconAsset.width ?: 24 }}" height="{{ iconAsset.height ?: 24 }}" loading="lazy">
        {% endif %}
    {% endif %}
{% endmacro %}

{# Renders one node's badge, if it has one — the short flag beside a label: "Products [NEW]". #}
{% macro badge(node) %}
    {%- if node.hasBadge() %} <span class="{{ node.badgeClass() }}">{{ node.badge }}</span>{% endif -%}
{% endmacro %}

{# "Opens in a new tab", for the accessible name of a link that does. #}
{% macro newTabHint(node) %}
    {%- if node.opensInNewTab() %} <span class="menu-builder-visually-hidden" style="position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0 0 0 0);clip-path:inset(50%);white-space:nowrap;border:0">{{ "(opens in a new tab)"|t('menu-builder') }}</span>{% endif -%}
{% endmacro %}

{% macro render(nodes, disclosure = 'details', idPrefix = '', viewport = 'both') %}
    {% import _self as self %}
    <ul>
        {% for node in nodes %}
            {#
               The entire CSS contract for a single shared navigation: one attribute, one of two
               values, emitted only on items an editor actually restricted.
            #}
            {% set viewportAttribute = viewport == 'both' ? node.viewportAttribute() : null %}
            {% if node.type == 'separator' %}
                {# The `<hr>` is the separator — that is its native role. #}
                <li{% if node.cssClass %} class="{{ node.cssClass }}"{% endif %}{% if node.htmlId %} id="{{ idPrefix ? idPrefix ~ '-' : '' }}{{ node.htmlId }}"{% endif %}{% if viewportAttribute %} data-mb-viewport="{{ viewportAttribute }}"{% endif %}><hr></li>
            {% else %}
                {% set liClasses = (node.cssClass ? node.cssClass ~ ' ' : '') ~ (node.isActiveOrAncestor() ? 'is-active' : '') %}
                <li{% if liClasses|trim %} class="{{ liClasses|trim }}"{% endif %}{% if node.htmlId %} id="{{ idPrefix ? idPrefix ~ '-' : '' }}{{ node.htmlId }}"{% endif %}{% if viewportAttribute %} data-mb-viewport="{{ viewportAttribute }}"{% endif %}>
                    {% if node.isClickable %}
                        {#
                           `aria-current="page"` is `isActive` only — the one node whose URL *is*
                           the page being served.
                        #}
                        <a href="{{ node.url }}"
                           {% if node.opensInNewTab() %}target="_blank"{% endif %}
                           {% if node.rel %}rel="{{ node.rel }}"{% endif %}
                           {% if node.ariaLabel %}aria-label="{{ node.ariaLabel }}"{% endif %}
                           {% if node.titleAttribute %}title="{{ node.titleAttribute }}"{% endif %}
                           {% if node.isActive %}aria-current="page"{% endif %}
                           {%- for key, value in node.safeHtmlAttributes() %} {{ key }}="{{ value }}"{% endfor %}
                        >{{ self.icon(node) }}{{ node.title }}{{ self.badge(node) }}{{ self.newTabHint(node) }}</a>
                    {% else %}
                        {# A non-clickable heading is a label, never a fake link — no href, ever. #}
                        <span{% if node.ariaLabel %} aria-label="{{ node.ariaLabel }}"{% endif %}{% if node.titleAttribute %} title="{{ node.titleAttribute }}"{% endif %}
                              {%- for key, value in node.safeHtmlAttributes() %} {{ key }}="{{ value }}"{% endfor %}>{{ self.icon(node) }}{{ node.title }}{{ self.badge(node) }}</span>
                    {% endif %}

                    {% if node.megaMenu and node.hasChildren() %}
                        {{ self.renderMegaMenu(node, disclosure, idPrefix, viewport) }}
                    {% elseif node.hasChildren() and viewport == 'mobile' and disclosure != 'none' and node.isMobileCollapsible() %}
                        {# A drawer that renders every level open is a drawer nobody can scroll. #}
                        {{ self.mobileSubmenu(node, self.render(node.children, disclosure, idPrefix, viewport)) }}
                    {% elseif node.hasChildren() %}
                        {#
                           A plain submenu is a nested list of ordinary links, with nothing hiding
                           them from the keyboard: every child is a Tab stop wherever it sits, and
                           no disclosure state is claimed for CSS to contradict.
                        #}
                        {{ self.render(node.children, disclosure, idPrefix, viewport) }}
                    {% endif %}
                </li>
            {% endif %}
        {% endfor %}
    </ul>
{% endmacro %}
