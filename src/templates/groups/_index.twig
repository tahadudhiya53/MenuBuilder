{% extends "_layouts/cp" %}

{% set title = "Menus"|t('menubuilder') %}

{% block actionButton %}
    {% if canManageSettings %}
        {% if edition.canCreate %}
            <a href="{{ url('menubuilder/groups/new') }}" class="btn submit add icon">{{ "New menu"|t('menubuilder') }}</a>
        {% else %}
            {# The button stays, and answers. #}
            <button type="button" class="btn add icon" data-mb-action="upgrade-required">{{ "New menu"|t('menubuilder') }}</button>
        {% endif %}
    {% endif %}
{% endblock %}

{% block content %}
    {# Edition status. #}
    <div class="menu-builder-edition">
        <div class="menu-builder-edition-facts">
            <div class="menu-builder-edition-fact">
                <span class="menu-builder-edition-label">{{ "Edition"|t('menubuilder') }}</span>
                <span class="menu-builder-edition-value">{{ edition.editionName }}</span>
            </div>
            <div class="menu-builder-edition-fact">
                <span class="menu-builder-edition-label">{{ "Menus"|t('menubuilder') }}</span>
                <span class="menu-builder-edition-value">
                    {%- if edition.maxMenus is null -%}
                        {{ "Unlimited"|t('menubuilder') }}
                    {%- else -%}
                        {{ "{count} / {max}"|t('menubuilder', { count: edition.menuCount, max: edition.maxMenus }) }}
                    {%- endif -%}
                </span>
            </div>
            {% if edition.isPro and edition.licenseActive %}
                <div class="menu-builder-edition-fact">
                    <span class="menu-builder-edition-label">{{ "License"|t('menubuilder') }}</span>
                    <span class="menu-builder-edition-value"><span class="status green"></span>{{ "Active"|t('menubuilder') }}</span>
                </div>
            {% endif %}
        </div>
        {% if not edition.isPro and edition.upgradeUrl %}
            <a href="{{ edition.upgradeUrl }}" class="btn menu-builder-edition-upgrade">{{ "Upgrade to Pro"|t('menubuilder') }}</a>
        {% endif %}
    </div>

    {% if not edition.canCreate and canManageSettings %}
        <p class="menu-builder-edition-notice light">{{ edition.limitMessage }}</p>
    {% endif %}

    {#
       Reordering needs the same permission every other menu-level mutation does, and needs more
       than one row to mean anything.
    #}
    {% set canReorder = canManageSettings and rows|length > 1 %}

    {% if canReorder %}
        <p id="menu-builder-group-reorder-help" class="visually-hidden">
            {{ "Up and down arrows move this menu within the list. Changes save as you go."|t('menubuilder') }}
        </p>
    {% endif %}

    {% if rows|length %}
        {#
           `.menu-builder-groups-pane` cancels the negative top margin `.tablepane` carries for
           tables that start a pane — this one follows the edition strip, which it was overlapping.
        #}
        <div class="tablepane menu-builder-groups-pane">
            <table class="data fullwidth" id="menu-builder-groups">
                <thead>
                    <tr>
                        {% if canReorder %}
                            <td class="thin"><span class="visually-hidden">{{ "Reorder"|t('menubuilder') }}</span></td>
                        {% endif %}
                        <th scope="col">{{ "Name"|t('menubuilder') }}</th>
                        <th scope="col">{{ "Handle"|t('menubuilder') }}</th>
                        <th scope="col">{{ "Status"|t('menubuilder') }}</th>
                        <th scope="col">{{ "Items"|t('menubuilder') }}</th>
                        <th scope="col">{{ "Last updated"|t('menubuilder') }}</th>
                        <td class="thin"><span class="visually-hidden">{{ "Actions"|t('menubuilder') }}</span></td>
                    </tr>
                </thead>
                <tbody>
                    {% for row in rows %}
                        {% set group = row.group %}
                        <tr data-id="{{ group.id }}" data-handle="{{ group.handle }}" data-name="{{ group.name }}">
                            {% if canReorder %}
                                {#
                                   Focusable and operable from the keyboard, for the same reason the
                                   item tree's handle is (see dashboard/_items.twig): a
                                   `role="button"` that answers only to a mouse is an inaccessible
                                   control. `.move` is what Craft.DataTableSorter drags by.
                                #}
                                <td class="thin">
                                    <a class="menu-builder-drag-handle move icon"
                                       role="button"
                                       tabindex="0"
                                       title="{{ 'Drag to reorder, or use the arrow keys'|t('menubuilder') }}"
                                       aria-label="{{ 'Reorder {name}. Use the up and down arrow keys to move it within the list.'|t('menubuilder', { name: group.name }) }}"
                                       aria-describedby="menu-builder-group-reorder-help"></a>
                                </td>
                            {% endif %}
                            <th scope="row">
                                <a href="{{ url('menubuilder/' ~ group.handle) }}">{{ group.name }}</a>
                            </th>
                            <td><code>{{ group.handle }}</code></td>
                            <td>
                                {#
                                   Craft's `.status` needs a modifier to render anything; `.status
                                   ''` was an empty circle that read as "no status" rather than
                                   "off".
                                #}
                                <span class="status {{ group.enabled ? 'green' : 'disabled' }}"></span><span class="menu-builder-status-label">{{ group.enabled ? "Enabled"|t('menubuilder') : "Disabled"|t('menubuilder') }}</span>
                            </td>
                            <td>{{ row.itemCount }}</td>
                            <td>{{ group.dateUpdated ? group.dateUpdated|datetime('short') : '' }}</td>
                            <td class="thin">
                                <div class="menu-builder-row-actions">
                                    <button type="button" class="btn small settings icon menubtn" title="{{ 'Actions'|t('menubuilder') }}" aria-label="{{ 'Actions for {name}'|t('menubuilder', { name: group.name }) }}"></button>
                                    <div class="menu">
                                        <ul>
                                            <li><a href="{{ url('menubuilder/' ~ group.handle) }}" role="button">{{ "Edit menu items"|t('menubuilder') }}</a></li>
                                            <li><a href="{{ url('menubuilder/groups/' ~ group.id) }}" role="button">{{ canManageSettings ? "Menu settings"|t('menubuilder') : "View menu settings"|t('menubuilder') }}</a></li>
                                            {% if canManageSettings %}
                                                <li><a data-mb-action="toggle-group" data-id="{{ group.id }}" role="button">{{ group.enabled ? "Disable"|t('menubuilder') : "Enable"|t('menubuilder') }}</a></li>
                                                <li><a data-mb-action="duplicate-group" data-id="{{ group.id }}" role="button">{{ "Duplicate"|t('menubuilder') }}</a></li>
                                            {% endif %}
                                        </ul>
                                        {% if canDelete %}
                                            <hr>
                                            <ul>
                                                <li><a data-mb-action="delete-group" data-id="{{ group.id }}" data-name="{{ group.name }}" data-item-count="{{ row.itemCount }}" class="error" role="button">{{ "Delete"|t('app') }}</a></li>
                                            </ul>
                                        {% endif %}
                                    </div>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <div class="zilch">
            <p>{{ "No menus yet"|t('menubuilder') }}</p>
            <p class="light">{{ "A menu holds the items your templates render as navigation."|t('menubuilder') }}</p>
            {% if canManageSettings and edition.canCreate %}
                <p><a href="{{ url('menubuilder/groups/new') }}" class="btn submit add icon">{{ "New menu"|t('menubuilder') }}</a></p>
            {% elseif canManageSettings %}
                <p class="light">{{ edition.limitMessage }}</p>
            {% else %}
                <p class="light">{{ "You don’t have permission to create menus."|t('menubuilder') }}</p>
            {% endif %}
        </div>
    {% endif %}
{% endblock %}

{% js %}
(function() {
    // One in-flight request per row.
    var busy = {};

    function run(link, action, data, failureMessage, onDone) {
        var id = link.getAttribute('data-id');

        if (busy[id]) {
            return;
        }

        busy[id] = true;
        var row = link.closest('tr') || document.querySelector('tr[data-id="' + id + '"]');

        if (row) {
            row.setAttribute('aria-busy', 'true');
            row.classList.add('menu-builder-row-busy');
        }

        Craft.sendActionRequest('POST', action, { data: data })
            .then(onDone)
            .catch(function(error) {
                delete busy[id];

                if (row) {
                    row.removeAttribute('aria-busy');
                    row.classList.remove('menu-builder-row-busy');
                }

                window.MenuBuilder.displayError(error, failureMessage);
            });
    }

    // The [ Upgrade to Pro ] / [ Cancel ] prompt.
    var upgradeUrl = {{ (edition.upgradeUrl ?? '')|json_encode|raw }};

    document.querySelectorAll('[data-mb-action="upgrade-required"]').forEach(function(button) {
        button.addEventListener('click', function(event) {
            event.preventDefault();

            var message = {{ edition.limitMessage|json_encode|raw }};

            if (!upgradeUrl) {
                window.alert(message);
                return;
            }

            if (window.confirm(message + '\n\n' + Craft.t('menubuilder', 'Upgrade to Pro?'))) {
                window.location.href = upgradeUrl;
            }
        });
    });

    document.querySelectorAll('[data-mb-action="duplicate-group"]').forEach(function(link) {
        link.addEventListener('click', function(event) {
            event.preventDefault();
            run(link, 'menubuilder/groups/duplicate', { id: link.getAttribute('data-id') },
                Craft.t('menubuilder', 'Couldn’t duplicate that menu.'),
                function(response) {
                    // Straight to the copy, which is what the editor wants to rename — the list
                    // reload used to leave them hunting for a row named "… 1" somewhere in the
                    // table.
                    window.location.href = response.data.url;
                });
        });
    });

    document.querySelectorAll('[data-mb-action="toggle-group"]').forEach(function(link) {
        link.addEventListener('click', function(event) {
            event.preventDefault();

            var id = link.getAttribute('data-id');

            run(link, 'menubuilder/groups/toggle', { id: id },
                Craft.t('menubuilder', 'Couldn’t update that menu.'),
                function(response) {
                    // Patched in place rather than reloaded: a full reload for a status flip threw
                    // away scroll position and wiped the confirmation it had just raised.
                    var enabled = !!(response.data && response.data.enabled);
                    var row = document.querySelector('tr[data-id="' + id + '"]');

                    if (row) {
                        var status = row.querySelector('.status');
                        var statusLabel = row.querySelector('.menu-builder-status-label');

                        if (status) {
                            status.className = 'status ' + (enabled ? 'green' : 'disabled');
                        }

                        if (statusLabel) {
                            statusLabel.textContent = enabled
                                ? Craft.t('menubuilder', 'Enabled')
                                : Craft.t('menubuilder', 'Disabled');
                        }

                        row.removeAttribute('aria-busy');
                        row.classList.remove('menu-builder-row-busy');
                    }

                    // The row menu may have been relocated near <body> by Craft's disclosure JS, so
                    // reach it by id, not through the row (same reason tree.js looks rows up by
                    // id).
                    var toggle = document.querySelector('[data-mb-action="toggle-group"][data-id="' + id + '"]');
                    if (toggle) {
                        toggle.textContent = enabled
                            ? Craft.t('menubuilder', 'Disable')
                            : Craft.t('menubuilder', 'Enable');
                    }

                    delete busy[id];

                    window.MenuBuilder.success(enabled
                        ? Craft.t('menubuilder', 'Menu enabled.')
                        : Craft.t('menubuilder', 'Menu disabled.'));
                });
        });
    });

    // Reordering the menus list.
    (function() {
        var table = document.getElementById('menu-builder-groups');

        // The handles are rendered only when this user may reorder and there is more than one
        // menu, so their absence is the whole check.
        if (!table || !table.querySelector('a.menu-builder-drag-handle')) {
            return;
        }

        var $table = $(table);
        var saving = false;

        // The one persistence path, whether the order came from a drop or from an arrow key —
        // the same rule tree.js follows, so a keyboard move can't drift from a drag.
        function persist() {
            if (saving) {
                return;
            }

            saving = true;

            var ids = [].map.call(
                table.querySelectorAll('tbody tr[data-id]'),
                function(row) { return row.getAttribute('data-id'); }
            );

            Craft.sendActionRequest('POST', 'menubuilder/groups/reorder', { data: { ids: ids } })
                .then(function() {
                    saving = false;
                    window.MenuBuilder.success(Craft.t('menubuilder', 'Menus reordered.'));
                })
                .catch(function(error) {
                    saving = false;
                    window.MenuBuilder.displayError(error, Craft.t('menubuilder', 'Couldn’t reorder the menus.'));

                    // The server is the order of record, and it just refused this one.
                    window.location.reload();
                });
        }

        new Craft.DataTableSorter($table, {
            onSortChange: persist
        });

        // Keyboard equivalent: move the row, keep focus on the handle that moved it, persist
        // through the same call a drop makes.
        $table.on('keydown', 'a.menu-builder-drag-handle', function(event) {
            // Cmd/Ctrl/Alt + arrow belongs to the browser.
            if (event.metaKey || event.ctrlKey || event.altKey) {
                return;
            }

            var row = event.currentTarget.closest('tr');

            if (!row) {
                return;
            }

            var moved = false;

            if (event.keyCode === Garnish.UP_KEY) {
                var previous = row.previousElementSibling;

                if (previous) {
                    row.parentNode.insertBefore(row, previous);
                    moved = true;
                }
            } else if (event.keyCode === Garnish.DOWN_KEY) {
                var next = row.nextElementSibling;

                if (next) {
                    row.parentNode.insertBefore(next, row);
                    moved = true;
                }
            } else {
                return;
            }

            // Claimed either way: an unhandled arrow scrolls the page, which reads as "the control
            // did something" when it did not.
            event.preventDefault();

            if (moved) {
                // Moving a row in the DOM doesn't move focus with it in every browser.
                event.currentTarget.focus();
                persist();
            }
        });
    })();

    document.querySelectorAll('[data-mb-action="delete-group"]').forEach(function(link) {
        link.addEventListener('click', function(event) {
            event.preventDefault();

            var name = link.getAttribute('data-name');
            var itemCount = parseInt(link.getAttribute('data-item-count'), 10) || 0;

            // Say how much is about to go: "and all of its menu items" gave no sense of whether
            // that was two items or two hundred.
            var message = itemCount
                ? Craft.t('menubuilder', 'Delete “{name}” and its {count} menu item(s)? This cannot be undone.', { name: name, count: itemCount })
                : Craft.t('menubuilder', 'Delete “{name}”? This cannot be undone.', { name: name });

            if (!confirm(message)) {
                return;
            }

            var id = link.getAttribute('data-id');

            run(link, 'menubuilder/groups/delete', { id: id },
                Craft.t('menubuilder', 'Couldn’t delete that menu.'),
                function() {
                    var row = document.querySelector('tr[data-id="' + id + '"]');
                    var table = row && row.closest('table');

                    if (row) {
                        row.remove();
                    }

                    window.MenuBuilder.success(Craft.t('menubuilder', 'Menu deleted.'));

                    // Nothing left to list — reload so the empty state (and its "New menu" call
                    // to action) replaces the bare table.
                    if (table && !table.querySelectorAll('tbody tr').length) {
                        window.location.reload();
                    }
                });
        });
    });
})();
{% endjs %}

{% do view.registerAssetBundle("Tahadudhiya\\MenuBuilder\\web\\assets\\cp\\CpAsset") %}
