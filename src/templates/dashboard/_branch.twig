<ul class="menu-builder-tree-list" data-parent-id="{{ parentId ?? '' }}">
    {% for item in items %}
        <li class="menu-builder-item{{ item.enabled ? '' : ' menu-builder-item-disabled' }}" data-id="{{ item.id }}" data-level="{{ level }}">
            <div class="menu-builder-item-row">
                {% if canEdit %}
                    <a class="menu-builder-drag-handle move icon" title="{{ 'Reorder'|t('app') }}" role="button" tabindex="0" aria-label="{{ 'Reorder {title}'|t('menu-builder', { title: item.title }) }}"></a>
                {% endif %}

                <span class="menu-builder-item-badge">
                    {% if item.type == 'nonclickable' or item.type == 'separator' %}
                        <span class="badge">{{ "Heading"|t('menu-builder') }}</span>
                    {% endif %}
                    {% if not item.enabled %}
                        <span class="badge">{{ "Disabled"|t('menu-builder') }}</span>
                    {% endif %}
                </span>

                <span class="menu-builder-item-title">
                    {{ item.title|default('(' ~ 'untitled'|t('menu-builder') ~ ')') }}
                    <span class="light code">{{ item.type }}</span>
                </span>

                <div class="menu-builder-item-actions">
                    {% if canEdit %}
                        <button type="button" class="btn small icon menu-builder-move-up" title="{{ 'Move up'|t('menu-builder') }}" aria-label="{{ 'Move up'|t('menu-builder') }}">&uarr;</button>
                        <button type="button" class="btn small icon menu-builder-move-down" title="{{ 'Move down'|t('menu-builder') }}" aria-label="{{ 'Move down'|t('menu-builder') }}">&darr;</button>
                        <button type="button" class="btn small menu-builder-outdent" title="{{ 'Outdent (move up one level)'|t('menu-builder') }}">&laquo;</button>
                        <button type="button" class="btn small menu-builder-indent" title="{{ 'Indent (make it a child of the menu above)'|t('menu-builder') }}">&raquo;</button>
                        <button type="button" class="btn small menu-builder-toggle" data-id="{{ item.id }}">
                            {{ item.enabled ? "Disable"|t('menu-builder') : "Enable"|t('menu-builder') }}
                        </button>
                        <a href="{{ url('menu-builder/' ~ group.handle ~ '/items/' ~ item.id) }}" class="btn small">{{ "Edit"|t('app') }}</a>
                        <button type="button" class="btn small menu-builder-duplicate" data-id="{{ item.id }}">{{ "Duplicate"|t('menu-builder') }}</button>
                        <button type="button" class="btn small delete menu-builder-delete" data-id="{{ item.id }}" data-title="{{ item.title }}">{{ "Delete"|t('app') }}</button>
                        <a href="{{ url('menu-builder/' ~ group.handle ~ '/items/new', { parentId: item.id }) }}" class="btn small">{{ "Add child"|t('menu-builder') }}</a>
                    {% endif %}
                </div>
            </div>

            {% if item.hasChildren() or canEdit %}
                {% include "menu-builder/dashboard/_branch" with { items: item.children, level: level + 1, parentId: item.id, group: group, canEdit: canEdit } %}
            {% endif %}
        </li>
    {% endfor %}
</ul>
