{% set typeLabels = {
    entry: 'Entry'|t('menubuilder'),
    category: 'Category'|t('menubuilder'),
    asset: 'Asset'|t('menubuilder'),
    url: 'Custom Link'|t('menubuilder'),
    anchor: 'Anchor'|t('menubuilder'),
    nonclickable: 'Heading'|t('menubuilder'),
    separator: 'Separator'|t('menubuilder'),
    dynamic: 'Dynamic'|t('menubuilder'),
} %}

{% set canSelect = canEdit or canDelete %}
{% set canReorder = canEdit and not isFiltered %}

{#
   Ancestor connector columns still open above this level — see the "Hierarchy connector" block in
   menu-builder-cp.css.
#}
{% set openColumns = openColumns ?? [] %}

{% for item in items %}
    {# The one label every control on this row refers to, resolved once per screen by
       MenuBuilderLabelHelper (see DashboardController::actionIndex) so the row, the quick-add
       parent picker and the editor heading can't drift — and so an item with no title of its own
       is named after the element it links to rather than by a placeholder. #}
    {% set itemLabel = itemLabels[item.id] ?? "(untitled)"|t('menubuilder') %}

    {#
       One lookup per row; healthy items are in the map too, so a missing key means "not checked"
       rather than "fine".
    #}
    {% set health = (itemHealth is defined and itemHealth[item.id] is defined) ? itemHealth[item.id] : null %}

    <li class="menu-builder-item{{ item.enabled ? '' : ' menu-builder-item-disabled' }}{{ item.hasChildren() ? ' menu-builder-item-has-children' : '' }}" data-id="{{ item.id }}" data-level="{{ level }}" data-parent-id="{{ parentId ?? '' }}" data-child-count="{{ item.children|length }}" data-no-children="{{ item.type == 'separator' ? '1' : '0' }}" data-title="{{ itemLabel }}" style="--mb-level: {{ level }}">
        {% if openColumns is not empty %}
            <span class="menu-builder-item-rails" aria-hidden="true">{% for column in openColumns %}<i style="--mb-rail: {{ column }}"></i>{% endfor %}</span>
        {% endif %}

        <div class="menu-builder-item-row">
            {% if canSelect %}
                <label class="menu-builder-bulk-checkbox">
                    <input type="checkbox" data-mb-bulk-select data-id="{{ item.id }}" aria-label="{{ 'Select {title}'|t('menubuilder', { title: itemLabel }) }}">
                </label>
            {% endif %}

            {% if canReorder %}
                {#
                   Focusable and operable from the keyboard: arrow keys move the row through the
                   same persistReorder() path a drag uses (see tree.js), so this isn't a mouse-only
                   control wearing a button role.
                #}
                <a class="menu-builder-drag-handle move icon"
                   role="button"
                   tabindex="0"
                   title="{{ 'Drag to reorder, or use the arrow keys'|t('menubuilder') }}"
                   aria-label="{{ 'Reorder {title}. Use the arrow keys to move it up, down, or in and out one level.'|t('menubuilder', { title: itemLabel }) }}"
                   aria-describedby="menu-builder-reorder-help"></a>
            {% elseif canEdit %}
                {#
                   Reordering is off while a search filters the tree — the rows on screen aren't
                   the real sibling set.
                #}
                <span class="menu-builder-drag-handle move icon is-disabled" aria-hidden="true" title="{{ 'Clear the search to reorder items.'|t('menubuilder') }}"></span>
            {% endif %}

            <span class="menu-builder-item-title">
                {% if item.title %}
                    {{ item.title }}
                {% else %}
                    <em class="light">{{ itemLabel }}</em>
                {% endif %}
            </span>

            {#
               The editor's own badge, previewed on the row so "does this item have a badge, and
               which one" is answerable without opening the slide-out.
            #}
            {% if item.hasBadge() %}
                <span class="menu-builder-item-badge badge {{ item.badgeStyle() ? 'menu-builder-item-badge--' ~ item.badgeStyle() }}" title="{{ 'Badge'|t('menubuilder') }}">{{ item.badge }}</span>
            {% endif %}

            <span class="menu-builder-item-type badge">{{ typeLabels[item.type] ?? item.type }}</span>

            {% if item.metadata.megaMenu.enabled ?? false %}
                <span class="menu-builder-item-status badge" title="{{ 'This item presents its children as a mega menu.'|t('menubuilder') }}">{{ "Mega menu"|t('menubuilder') }}</span>
            {% endif %}

            {% if not item.enabled %}
                {#
                   The `-disabled-flag` class is this badge's own hook: `-item-status` is shared
                   with the mega-menu and link-health badges, so the JS that adds/removes this one
                   on toggle needs a selector that can't collide with them (see tree.js `toggle()`).
                #}
                <span class="menu-builder-item-status menu-builder-item-disabled-flag badge disabled-badge">{{ "Disabled"|t('menubuilder') }}</span>
            {% endif %}

            {#
               Link health, from MenuBuilderLinkHealthService — the row says which* kind of
               problem it is (missing / disabled / unpublished / not on this site / no URL / invalid
               link / dead dynamic source) and, in the tooltip, what the front end is doing about
               it.
            #}
            {% if health and not health.isHealthy() %}
                <span class="menu-builder-item-status badge disabled-badge menu-builder-item-health-flag menu-builder-item-health--{{ health.status }}"
                      title="{{ health.message() }} {{ health.consequence() }}">
                    <span aria-hidden="true">⚠</span> {{ health.label() }}
                </span>
            {% endif %}

            {% if item.hasChildren() %}
                {#
                   `title` alone is not reliably announced, and a bare number read out on its own
                   says nothing about what it counts.
                #}
                <span class="menu-builder-item-childcount light" title="{{ '{count} child items'|t('menubuilder', { count: item.children|length }) }}">
                    <span aria-hidden="true">{{ item.children|length }}</span>
                    <span class="visually-hidden">{{ '{count} child items'|t('menubuilder', { count: item.children|length }) }}</span>
                </span>
            {% endif %}

            {% if canEdit or canCreate or canDelete %}
                <div class="menu-builder-item-actions">
                    <button type="button" class="btn small settings icon menubtn" title="{{ 'Actions'|t('menubuilder') }}" aria-label="{{ 'Actions for {title}'|t('menubuilder', { title: itemLabel }) }}"></button>
                    <div class="menu">
                        <ul>
                            {% if canEdit %}
                                <li>
                                    <a data-mb-action="edit" data-id="{{ item.id }}" role="button">{{ "Edit"|t('app') }}</a>
                                </li>
                            {% endif %}
                            {% if canCreate %}
                                <li>
                                    <a data-mb-action="duplicate" data-id="{{ item.id }}" role="button">{{ "Duplicate"|t('menubuilder') }}</a>
                                </li>
                            {% endif %}
                        </ul>
                        {# The recovery route for an item whose linked element is gone. #}
                        {% if canEdit and health and health.needsElementRecovery() %}
                            <hr>
                            <ul>
                                <li>
                                    <a data-mb-action="edit" data-id="{{ item.id }}" role="button">{{ "Fix this link…"|t('menubuilder') }}</a>
                                </li>
                            </ul>
                        {% endif %}
                        {% if (canEdit or canCreate) and (canEdit or canDelete) %}<hr>{% endif %}
                        <ul>
                            {% if canEdit %}
                                <li>
                                    <a data-mb-action="toggle" data-id="{{ item.id }}" role="button">
                                        {{ item.enabled ? "Disable"|t('menubuilder') : "Enable"|t('menubuilder') }}
                                    </a>
                                </li>
                            {% endif %}
                            {% if canDelete %}
                                <li>
                                    <a data-mb-action="delete" data-id="{{ item.id }}" data-title="{{ itemLabel }}" data-has-children="{{ item.hasChildren() ? '1' : '0' }}" class="error" role="button">{{ "Delete"|t('app') }}</a>
                                </li>
                            {% endif %}
                        </ul>
                    </div>
                </div>
            {% endif %}

            {#
               The same affordance Craft's own element indexes give every row with a public URL:
               one click from the menu to the page it points at, in a new tab, so a link can be
               checked without rebuilding it in the address bar. Only rows that address a real,
               reachable page get one — see MenuBuilderVisitUrlHelper.
            #}
            {% set itemUrl = (itemUrls is defined and itemUrls[item.id] is defined) ? itemUrls[item.id] : null %}
            {% if itemUrl %}
                <a class="menu-builder-item-visit"
                   href="{{ itemUrl }}"
                   target="_blank"
                   rel="noopener"
                   data-icon="world"
                   title="{{ 'Visit webpage'|t('app') }}"
                   aria-label="{{ 'Visit {title}'|t('menubuilder', { title: itemLabel }) }}"></a>
            {% endif %}
        </div>
    </li>

    {% if item.hasChildren() %}
        {# This item's own column (level - 1) stays open for its descendants
           only while it still has a sibling below to reach. Level-1 rows own
           no column, hence the level check. #}
        {% include "menubuilder/dashboard/_items" with treeContext|merge({
            items: item.children,
            level: level + 1,
            parentId: item.id,
            openColumns: openColumns|merge(level >= 2 and not loop.last ? [level - 1] : []),
        }) %}
    {% endif %}
{% endfor %}
