{# Optional breadcrumb renderer, the counterpart to `_macros/tree.twig`. #}
{#
   @param trail MenuBuilderBreadcrumbTrail|null — `craft.menuBuilder.breadcrumbs(...)` @param
   label The landmark's accessible name.
#}
{% macro render(trail, label = null, linkCurrent = true) %}
    {% import _self as self %}
    {% if trail is not empty %}
        <nav class="menu-builder-breadcrumbs" aria-label="{{ label ?: "Breadcrumb"|t('menubuilder') }}" data-menu-builder-breadcrumbs>
            <ol class="menu-builder-breadcrumbs-list">
                {% for crumb in trail %}
                    {{ self.crumb(crumb, loop.last, linkCurrent) }}
                {% endfor %}
            </ol>
        </nav>
    {% endif %}
{% endmacro %}

{# One crumb. #}
{% macro crumb(node, isCurrent, linkCurrent = true) %}
    {#
       The "opens in a new tab" hint is imported from the tree macros rather than restated here: a
       crumb that opens a new tab owes a screen-reader user the same warning the menu's own link
       does, and one definition of that phrase is one place for it to stay correct.
    #}
    {% import "menubuilder/_macros/tree" as menuMacros %}
    <li class="menu-builder-breadcrumb{{ isCurrent ? ' is-current' : '' }}{{ node.cssClass ? ' ' ~ node.cssClass : '' }}">
        {%- if node.isClickable and (linkCurrent or not isCurrent) -%}
            <a href="{{ node.url }}"
               {%- if node.opensInNewTab() %} target="_blank"{% endif %}
               {%- if node.rel %} rel="{{ node.rel }}"{% endif %}
               {%- if node.ariaLabel %} aria-label="{{ node.ariaLabel }}"{% endif %}
               {%- if node.titleAttribute %} title="{{ node.titleAttribute }}"{% endif %}
               {%- if isCurrent %} aria-current="page"{% endif %}
               {%- for key, value in node.safeHtmlAttributes() %} {{ key }}="{{ value }}"{% endfor %}>{{ node.title }}{{ menuMacros.newTabHint(node) }}</a>
        {%- else -%}
            <span{% if isCurrent %} aria-current="page"{% endif %}
                 {%- if node.ariaLabel %} aria-label="{{ node.ariaLabel }}"{% endif %}
                 {%- if node.titleAttribute %} title="{{ node.titleAttribute }}"{% endif %}
                 {%- for key, value in node.safeHtmlAttributes() %} {{ key }}="{{ value }}"{% endfor %}>{{ node.title }}</span>
        {%- endif -%}
    </li>
{% endmacro %}
