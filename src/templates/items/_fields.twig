{% import "_includes/forms" as forms %}

{% set megaMenuConfig = item.metadata.megaMenu ?? [] %}
{% set badgeStyleOptions = [
    { label: "Default"|t('menu-builder'), value: 'default' },
    { label: "Info"|t('menu-builder'), value: 'info' },
    { label: "Success"|t('menu-builder'), value: 'success' },
    { label: "Warning"|t('menu-builder'), value: 'warning' },
    { label: "Critical"|t('menu-builder'), value: 'critical' },
] %}
{% set dynamicSource = item.metadata.dynamicSource ?? [] %}
{% set mobileConfig = item.mobileConfig() %}

{% set loggedInRule = item.visibility|filter(r => r.type == 'loggedIn')|first ?: null %}
{% set loggedOutRule = item.visibility|filter(r => r.type == 'loggedOut')|first ?: null %}
{% set userGroupRule = item.visibility|filter(r => r.type == 'userGroup')|first ?: null %}
{% set siteRule = item.visibility|filter(r => r.type == 'site')|first ?: null %}
{% set dateRule = item.visibility|filter(r => r.type == 'dateRange')|first ?: null %}
{% set envRule = item.visibility|filter(r => r.type == 'environment')|first ?: null %}

{% set entryElement = item.type == 'entry' and item.elementId ? craft.entries.id(item.elementId).status(null).one() : null %}
{% set categoryElement = item.type == 'category' and item.elementId ? craft.categories.id(item.elementId).status(null).one() : null %}
{% set assetElement = item.type == 'asset' and item.elementId ? craft.assets.id(item.elementId).one() : null %}
{% set imageElement = item.image ? craft.assets.id(item.image).one() : null %}
{% set iconType = item.iconType() %}
{% set iconAssetElement = item.iconAssetId() ? craft.assets.id(item.iconAssetId()).one() : null %}

<div class="menu-builder-item-fields" data-menu-builder-item-fields>
<input type="hidden" name="action" value="menu-builder/items/save">
<input type="hidden" name="itemId" value="{{ item.id }}">
<input type="hidden" name="groupId" value="{{ group.id }}">
<input type="hidden" name="parentId" value="{{ item.parentId }}">
{{ redirectInput('menu-builder/' ~ group.handle) }}
{{ csrfInput() }}

{# `items/edit` needs only `view`, so this partial can be rendered for someone
   who may not save. One disabled fieldset makes every control inside it
   genuinely inert rather than threading a flag through every field call.
   `canEdit` defaults to true so any caller that doesn't pass it (the
   slide-out renders the same partial) behaves exactly as before. #}
<fieldset class="menu-builder-fieldset"{{ (canEdit ?? true) ? '' : ' disabled' }}>

{# Link health for this item, computed by ItemsController from
   MenuBuilderLinkHealthService. Shown first because it explains why the
   editor is here at all, and because the two fields that fix it — the element
   picker and the fallback behaviour — are further down the same form.

   It is worded entirely from the health status and this item's own fallback
   setting. Nothing about the linked element is read here or by the health
   object, so an editor without access to the (disabled, unpublished, or
   deleted) content learns nothing about it beyond "this link doesn't work". #}
{% if health is defined and health and not health.isHealthy() %}
    <div class="menu-builder-notice warning menu-builder-health-notice" role="status">
        <p><strong>{{ health.label() }}</strong> — {{ health.message() }}</p>
        <p class="light">{{ health.consequence() }}</p>
        {% if health.needsElementRecovery() %}
            {# Four safe ways out, none of which this screen takes on the
               editor's behalf: MenuBuilder never discards a menu item because
               the thing it pointed at went away. #}
            <ul class="menu-builder-health-actions">
                <li>{{ "Pick different content below to relink this item."|t('menu-builder') }}</li>
                <li>{{ "Or set the fallback behaviour to a fallback URL, so it keeps working."|t('menu-builder') }}</li>
                <li>{{ "Or disable this item, so it stops rendering without being lost."|t('menu-builder') }}</li>
                <li>{{ "Or delete it from the menu — that one can’t be undone."|t('menu-builder') }}</li>
            </ul>
        {% endif %}
    </div>
{% endif %}

<div data-mb-section="basic" data-mb-description="{{ "Choose what this item links to and the label shown in the menu."|t('menu-builder') }}">
    <h2>{{ "Basic"|t('menu-builder') }}</h2>

    {{ forms.selectField({
        label: "Link type"|t('menu-builder'),
        id: 'type',
        name: 'type',
        value: item.type,
        options: [
            { label: "Entry"|t('menu-builder'), value: 'entry' },
            { label: "Category"|t('menu-builder'), value: 'category' },
            { label: "Asset"|t('menu-builder'), value: 'asset' },
            { label: "Custom URL"|t('menu-builder'), value: 'url' },
            { label: "Anchor"|t('menu-builder'), value: 'anchor' },
            { label: "Non-clickable heading"|t('menu-builder'), value: 'nonclickable' },
            { label: "Separator"|t('menu-builder'), value: 'separator' },
            { label: "Dynamic navigation"|t('menu-builder'), value: 'dynamic' },
        ],
    }) }}

    {{ forms.textField({
        label: "Title"|t('menu-builder'),
        instructions: item.type in ['entry', 'category', 'asset'] ? "Leave blank to use the linked element's own title — required if the item stays visible when that element becomes unavailable."|t('menu-builder') : null,
        id: 'title',
        name: 'title',
        value: item.title,
        errors: item.getErrors('title'),
    }) }}

    <div data-link-section="entry" class="menu-builder-link-section">
        {{ forms.elementSelectField({
            label: "Entry"|t('menu-builder'),
            id: 'entryElementId',
            name: 'elementId',
            elementType: 'craft\\elements\\Entry',
            sources: '*',
            single: true,
            limit: 1,
            elements: entryElement ? [entryElement] : [],
            errors: item.getErrors('elementId'),
        }) }}
    </div>

    <div data-link-section="category" class="menu-builder-link-section">
        {{ forms.elementSelectField({
            label: "Category"|t('menu-builder'),
            id: 'categoryElementId',
            name: 'elementId',
            elementType: 'craft\\elements\\Category',
            sources: '*',
            single: true,
            limit: 1,
            elements: categoryElement ? [categoryElement] : [],
        }) }}
    </div>

    <div data-link-section="asset" class="menu-builder-link-section">
        {{ forms.elementSelectField({
            label: "Asset"|t('menu-builder'),
            id: 'assetElementId',
            name: 'elementId',
            elementType: 'craft\\elements\\Asset',
            sources: '*',
            single: true,
            limit: 1,
            elements: assetElement ? [assetElement] : [],
        }) }}
    </div>

    <div data-link-section="url" class="menu-builder-link-section">
        {{ forms.textField({
            label: "URL"|t('menu-builder'),
            instructions: "Absolute URLs, root-relative paths, #fragments, mailto:, and tel: links are all accepted."|t('menu-builder'),
            id: 'customUrl',
            name: 'customUrl',
            value: item.customUrl,
            errors: item.getErrors('customUrl'),
        }) }}
    </div>

    <div data-link-section="anchor" class="menu-builder-link-section">
        {{ forms.textField({
            label: "Anchor handle"|t('menu-builder'),
            instructions: "Rendered as a link to #handle. Leave blank to reuse the Handle field in Advanced."|t('menu-builder'),
            id: 'anchorUrl',
            name: 'customUrl',
            value: item.customUrl,
            errors: item.getErrors('handle'),
        }) }}
    </div>

    <div data-link-section="dynamic" class="menu-builder-link-section">
        {{ forms.selectField({
            label: "Source"|t('menu-builder'),
            id: 'dynamicSourceType',
            name: 'dynamicSourceType',
            value: dynamicSource.sourceType ?? 'entries',
            options: [
                { label: "Entries (by section)"|t('menu-builder'), value: 'entries' },
                { label: "Categories (by group)"|t('menu-builder'), value: 'categories' },
                { label: "Assets (by volume)"|t('menu-builder'), value: 'assets' },
            ],
        }) }}
        {# One picker per source type, all posting the same `dynamicSourceId`
           the controller already reads — item-fields.js shows the one that
           matches and disables the rest, exactly as the link-type sections
           work, so a hidden picker's value can never be submitted.

           This used to be a bare number field asking the editor to go and
           look an internal ID up under Settings first. Nothing about the
           stored value changed. #}
        <div data-dynamic-source="entries">
            {{ forms.selectField({
                label: "Section"|t('menu-builder'),
                instructions: "Children are pulled from this section."|t('menu-builder'),
                id: 'dynamicSourceIdEntries',
                name: 'dynamicSourceId',
                value: dynamicSource.sourceId ?? '',
                options: [{ label: "Select a section…"|t('menu-builder'), value: '' }]
                    |merge(craft.app.entries.getAllSections()|map(section => { label: section.name, value: section.id })|values),
            }) }}
        </div>

        <div data-dynamic-source="categories">
            {{ forms.selectField({
                label: "Category group"|t('menu-builder'),
                instructions: "Children are pulled from this category group."|t('menu-builder'),
                id: 'dynamicSourceIdCategories',
                name: 'dynamicSourceId',
                value: dynamicSource.sourceId ?? '',
                options: [{ label: "Select a category group…"|t('menu-builder'), value: '' }]
                    |merge(craft.app.categories.getAllGroups()|map(categoryGroup => { label: categoryGroup.name, value: categoryGroup.id })|values),
            }) }}
        </div>

        <div data-dynamic-source="assets">
            {{ forms.selectField({
                label: "Volume"|t('menu-builder'),
                instructions: "Children are pulled from this asset volume."|t('menu-builder'),
                id: 'dynamicSourceIdAssets',
                name: 'dynamicSourceId',
                value: dynamicSource.sourceId ?? '',
                options: [{ label: "Select a volume…"|t('menu-builder'), value: '' }]
                    |merge(craft.app.volumes.getAllVolumes()|map(volume => { label: volume.name, value: volume.id })|values),
            }) }}
        </div>
        {# Blank means "no limit stored", which
           MenuBuilderDynamicNavigationService::normalizeConfig() reads as the
           maximum — that is the state a quick-added dynamic item starts in, so
           showing a made-up 10 here would report a value the item doesn't have.
           The cap comes from MenuBuilderItem::DYNAMIC_SOURCE_MAX_LIMIT rather
           than being written out again. #}
        {{ forms.textField({
            label: "Limit"|t('menu-builder'),
            instructions: "How many children to pull in. Leave blank for the maximum ({max}), which is enforced server-side regardless of what's entered here."|t('menu-builder', { max: dynamicSourceMaxLimit }),
            id: 'dynamicSourceLimit',
            name: 'dynamicSourceLimit',
            type: 'number',
            min: 1,
            max: dynamicSourceMaxLimit,
            value: dynamicSource.limit ?? '',
        }) }}
        {{ forms.selectField({
            label: "Order by"|t('menu-builder'),
            id: 'dynamicSourceOrderBy',
            name: 'dynamicSourceOrderBy',
            value: dynamicSource.orderBy ?? 'dateCreated desc',
            options: [
                { label: "Newest first"|t('menu-builder'), value: 'dateCreated desc' },
                { label: "Oldest first"|t('menu-builder'), value: 'dateCreated asc' },
                { label: "Title (A-Z)"|t('menu-builder'), value: 'title asc' },
                { label: "Title (Z-A)"|t('menu-builder'), value: 'title desc' },
            ],
        }) }}
    </div>

    {# Non-clickable headings and separators can never carry a link — no UI exposes one, and isLinkable() is authoritative regardless. #}
    <input type="hidden" name="clickable" id="clickableField" value="{{ item.type not in ['nonclickable', 'separator'] ? '1' : '' }}">

    {% if isNew %}
        <p class="light">{{ "Behavior, appearance, accessibility, visibility, mobile, and advanced settings become available once this menu item is saved."|t('menu-builder') }}</p>
    {% endif %}
</div>

{% if not isNew %}
<div data-mb-section="behavior" data-mb-description="{{ "Control availability, link destination, and broken-link fallback."|t('menu-builder') }}">
    <h2>{{ "Behavior"|t('menu-builder') }}</h2>

    {{ forms.lightswitchField({
        label: "Enabled"|t('menu-builder'),
        id: 'enabled',
        name: 'enabled',
        on: item.enabled,
    }) }}

    {# Target/rel/fallback only make sense for types that can actually produce a link — never for a non-clickable heading or a structural separator. #}
    <div data-link-section="entry,category,asset,url,anchor" class="menu-builder-link-section">
        {{ forms.selectField({
            label: "Open in"|t('menu-builder'),
            id: 'target',
            name: 'target',
            value: item.target,
            options: [
                { label: "Same window"|t('menu-builder'), value: '_self' },
                { label: "New tab"|t('menu-builder'), value: '_blank' },
            ],
        }) }}

        {{ forms.checkboxField({
            label: "Add rel=\"nofollow\""|t('menu-builder'),
            id: 'nofollow',
            name: 'nofollow',
            checked: item.rel and 'nofollow' in item.rel|split(' '),
        }) }}

        {{ forms.checkboxField({
            label: "Add rel=\"sponsored\""|t('menu-builder'),
            id: 'sponsored',
            name: 'sponsored',
            checked: item.rel and 'sponsored' in item.rel|split(' '),
        }) }}

        <h3>{{ "If the linked element becomes unavailable"|t('menu-builder') }}</h3>
        {{ forms.selectField({
            label: "Fallback behavior"|t('menu-builder'),
            id: 'fallbackBehavior',
            name: 'fallbackBehavior',
            value: item.fallbackBehavior,
            options: [
                { label: "Hide the menu item"|t('menu-builder'), value: 'hide' },
                { label: "Keep it, but disable the link"|t('menu-builder'), value: 'disableLink' },
                { label: "Use a fallback URL"|t('menu-builder'), value: 'fallbackUrl' },
            ],
        }) }}
        <div data-fallback-url>
            {{ forms.textField({
                label: "Fallback URL"|t('menu-builder'),
                id: 'fallbackUrl',
                name: 'fallbackUrl',
                value: item.fallbackUrl,
                errors: item.getErrors('fallbackUrl'),
            }) }}
        </div>
    </div>
</div>

<div data-mb-section="appearance" data-mb-description="{{ "Add icons, badges, imagery, and styling hooks."|t('menu-builder') }}">
    <h2>{{ "Appearance"|t('menu-builder') }}</h2>
    {{ forms.selectField({
        label: "Icon"|t('menu-builder'),
        instructions: "How this item's icon is stored. Raw SVG markup isn't accepted — upload the SVG and pick it as an asset."|t('menu-builder'),
        id: 'iconSource',
        name: 'iconSource',
        value: iconType,
        options: [
            { label: "None"|t('menu-builder'), value: '' },
            { label: "Icon handle / CSS class"|t('menu-builder'), value: 'class' },
            { label: "Asset"|t('menu-builder'), value: 'asset' },
        ],
    }) }}
    <div data-icon-class>
        {{ forms.textField({
            label: "Icon handle or CSS class"|t('menu-builder'),
            instructions: "Any identifier your templates know how to render — `icon-cart`, `fa fa-cart`, `heroicons/outline/home`."|t('menu-builder'),
            id: 'icon',
            name: 'icon',
            value: iconType == 'asset' ? '' : item.iconClass(),
            errors: item.getErrors('icon'),
        }) }}
    </div>
    <div data-icon-asset>
        {{ forms.elementSelectField({
            label: "Icon asset"|t('menu-builder'),
            instructions: "Rendered as an image, never inlined — an SVG uploaded here can't run script in the page."|t('menu-builder'),
            id: 'iconAsset',
            name: 'iconAsset',
            elementType: 'craft\\elements\\Asset',
            sources: '*',
            single: true,
            limit: 1,
            elements: iconAssetElement ? [iconAssetElement] : [],
        }) }}
    </div>
    {# Badge text is free text and is escaped where it renders, so no
       character is rejected here; the style beside it is a closed enum
       because that half reaches a class attribute. See helpers/BadgeHelper. #}
    {{ forms.textField({
        label: "Badge"|t('menu-builder'),
        instructions: "A short flag shown beside the label — NEW, SALE, BETA. Leave blank for no badge."|t('menu-builder'),
        id: 'badge',
        name: 'badge',
        value: item.badge,
        maxlength: 255,
        errors: item.getErrors('badge'),
    }) }}
    {{ forms.selectField({
        label: "Badge style"|t('menu-builder'),
        instructions: "Adds a `menu-builder-badge--<style>` class for your own CSS. Ignored when the badge is blank."|t('menu-builder'),
        id: 'badgeStyle',
        name: 'badgeStyle',
        options: badgeStyleOptions,
        value: item.badgeStyle() ?? 'default',
    }) }}
    {{ forms.textareaField({ label: "Description"|t('menu-builder'), id: 'description', name: 'description', value: item.description, rows: 2 }) }}
    {{ forms.elementSelectField({
        label: "Image"|t('menu-builder'),
        id: 'image',
        name: 'image',
        elementType: 'craft\\elements\\Asset',
        sources: '*',
        criteria: { kind: 'image' },
        single: true,
        limit: 1,
        elements: imageElement ? [imageElement] : [],
    }) }}
    {{ forms.lightswitchField({ label: "Featured"|t('menu-builder'), id: 'featured', name: 'featured', on: item.featured }) }}
    {{ forms.textField({ label: "CSS class"|t('menu-builder'), id: 'cssClass', name: 'cssClass', value: item.cssClass }) }}
</div>

<div data-mb-section="accessibility" data-mb-description="{{ "Provide clearer labels and helpful browser text."|t('menu-builder') }}">
    <h2>{{ "Accessibility"|t('menu-builder') }}</h2>
    {{ forms.textField({ label: "ARIA label"|t('menu-builder'), id: 'ariaLabel', name: 'ariaLabel', value: item.ariaLabel }) }}
    {{ forms.textField({ label: "Title attribute"|t('menu-builder'), id: 'titleAttribute', name: 'titleAttribute', value: item.titleAttribute }) }}
</div>

<div data-mb-section="visibility" data-mb-description="{{ "Choose who can see this item, where, and when."|t('menu-builder') }}">
    <h2>{{ "Visibility"|t('menu-builder') }}</h2>
    <p class="light">{{ "This menu item is shown when ALL of the checked/filled rules below pass. Leave everything blank to always show it. Ticking both logged-in and logged-out can never be satisfied, so the item would be hidden for everyone."|t('menu-builder') }}</p>

    {{ forms.checkboxField({ label: "Only show to logged-in users"|t('menu-builder'), id: 'visibilityLoggedIn', name: 'visibility[loggedIn]', checked: loggedInRule is not null }) }}
    {{ forms.checkboxField({ label: "Only show to logged-out (anonymous) visitors"|t('menu-builder'), id: 'visibilityLoggedOut', name: 'visibility[loggedOut]', checked: loggedOutRule is not null }) }}

    {{ forms.checkboxSelectField({
        label: "Restrict to user groups"|t('menu-builder'),
        id: 'visibilityUserGroups',
        name: 'visibility[userGroups]',
        values: userGroupRule.groupIds ?? [],
        options: craft.app.userGroups.getAllGroups()|map(g => { label: g.name, value: g.id }),
    }) }}

    {% if craft.app.getIsMultiSite() %}
        {{ forms.checkboxSelectField({
            label: "Restrict to sites"|t('menu-builder'),
            id: 'visibilitySites',
            name: 'visibility[sites]',
            values: siteRule.siteIds ?? [],
            options: craft.app.sites.getAllSites()|map(s => { label: s.name, value: s.id }),
        }) }}
    {% endif %}

    {{ forms.textField({ label: "Visible from"|t('menu-builder'), id: 'visibilityDateStart', name: 'visibility[dateStart]', type: 'datetime-local', value: dateRule.start ?? '' }) }}
    {{ forms.textField({ label: "Visible until"|t('menu-builder'), id: 'visibilityDateEnd', name: 'visibility[dateEnd]', type: 'datetime-local', value: dateRule.end ?? '' }) }}
    {# Rules are resolved with `|first ?: null` above: Twig's `first` returns `false`, not `null`, #}
    {# for an empty match, and `false is not null` is true — so without the coalesce this line #}
    {# tried to read `environments` off a bool and blew up the whole edit slideout. #}
    {{ forms.textField({ label: "Restrict to environments"|t('menu-builder'), instructions: "Comma-separated (matches CRAFT_ENVIRONMENT). An unrecognized environment hides the item."|t('menu-builder'), id: 'visibilityEnvironments', name: 'visibility[environments]', value: envRule is not null ? envRule.environments|join(', ') : '' }) }}
</div>

<div data-mb-section="megaMenu" data-mb-description="{{ "Arrange this item's children in a multi-column panel."|t('menu-builder') }}">
    <h2>{{ "Mega Menu"|t('menu-builder') }}</h2>
    <p class="light">{{ "Enable to present this item's children as a mega-menu panel grouped into columns. Each child picks its own column below."|t('menu-builder') }}</p>
    {{ forms.lightswitchField({
        label: "Enable mega menu for this item's children"|t('menu-builder'),
        id: 'megaMenuEnabled',
        name: 'megaMenuEnabled',
        on: megaMenuConfig.enabled ?? false,
    }) }}
    {{ forms.textField({
        label: "Columns"|t('menu-builder'),
        id: 'megaMenuColumns',
        name: 'megaMenuColumns',
        type: 'number',
        min: 1,
        max: 6,
        value: megaMenuConfig.columns ?? 1,
    }) }}
    {{ forms.textField({
        label: "This item's column (under its parent's mega menu)"|t('menu-builder'),
        instructions: "Only meaningful when this item's own parent has mega menu enabled. Columns beyond that parent's column count fall back to the first column."|t('menu-builder'),
        id: 'megaMenuColumn',
        name: 'megaMenuColumn',
        type: 'number',
        min: 1,
        max: 6,
        value: item.metadata.megaMenuColumn ?? '',
    }) }}
</div>

<div data-mb-section="mobile" data-mb-description="{{ "Fine-tune how this item appears on smaller screens."|t('menu-builder') }}">
    <h2>{{ "Mobile"|t('menu-builder') }}</h2>
    <p class="light">{{ "How this item behaves in a small-screen navigation. MenuBuilder decides which items belong to which navigation, in what order, and which branches collapse — your front-end templates decide the breakpoint. No menu is duplicated: this is the same item, presented differently."|t('menu-builder') }}</p>
    {{ forms.selectField({
        label: "Shown on"|t('menu-builder'),
        instructions: "Restrict this item to one navigation. “Desktop only” and “Mobile only” hide it from the other — the item, its link and its children all go with it."|t('menu-builder'),
        id: 'mobileVisibility',
        name: 'mobileVisibility',
        options: [
            { label: "Desktop and mobile"|t('menu-builder'), value: 'both' },
            { label: "Desktop only"|t('menu-builder'), value: 'desktopOnly' },
            { label: "Mobile only"|t('menu-builder'), value: 'mobileOnly' },
        ],
        value: item.mobileVisibility(),
    }) }}
    {{ forms.textField({
        label: "Mobile order"|t('menu-builder'),
        instructions: "Optional. Items with a number are placed in that order among their siblings on mobile; items without one keep the order you dragged them into and follow after. Only applies where the mobile navigation is rendered separately."|t('menu-builder'),
        id: 'mobileOrder',
        name: 'mobileOrder',
        type: 'number',
        min: 0,
        max: 9999,
        value: mobileConfig.order ?? '',
    }) }}
    {{ forms.selectField({
        label: "Children on mobile"|t('menu-builder'),
        instructions: "By default a branch collapses behind a disclosure on mobile, so a deep menu still fits a phone. “Always expanded” renders its children in place instead. Items with no children are unaffected."|t('menu-builder'),
        id: 'mobileCollapsible',
        name: 'mobileCollapsible',
        options: [
            { label: "Collapsed by default"|t('menu-builder'), value: '' },
            { label: "Always expanded"|t('menu-builder'), value: '0' },
        ],
        value: (mobileConfig.collapsible ?? null) is same as(false) ? '0' : '',
    }) }}
    {{ forms.selectField({
        label: "Mega menu on mobile"|t('menu-builder'),
        instructions: "Only meaningful when this item has mega menu enabled above. Stacking is almost always right on a phone; hiding removes those links from the mobile navigation entirely, so make sure this item links somewhere that reaches them."|t('menu-builder'),
        id: 'mobileMegaMenu',
        name: 'mobileMegaMenu',
        options: [
            { label: "Stack the columns"|t('menu-builder'), value: 'stack' },
            { label: "Keep the columns"|t('menu-builder'), value: 'columns' },
            { label: "Hide the panel"|t('menu-builder'), value: 'hide' },
        ],
        value: item.mobileMegaMenuBehavior(),
    }) }}
</div>

{% if group.customFields|length %}
{# Editor-defined fields for this menu (Menus → this menu → Custom fields).
   One control per definition, all posting under `customFields[<handle>]`;
   which handles may be stored at all is decided server-side from the same
   definitions (ItemsController::buildMetadata()), never from what was
   posted. Values live in the item's `metadata['custom']` bag — see
   helpers/CustomFieldHelper. #}
<div data-mb-section="customFields" data-mb-description="{{ "Set the extra content fields configured for this menu."|t('menu-builder') }}">
    <h2>{{ "Custom fields"|t('menu-builder') }}</h2>

    {% set customValues = item.customFieldValues() %}

    {% for field in group.customFields %}
        {% set value = customValues[field.handle] ?? null %}
        {% set customAssetElement = field.type == 'asset' and value ? craft.assets.id(value).one() : null %}
        {% set base = {
            label: field.name,
            instructions: field.instructions,
            id: 'customField-' ~ field.handle,
            name: 'customFields[' ~ field.handle ~ ']',
            required: field.required,
        } %}

        {% if field.type == 'textarea' %}
            {{ forms.textareaField(base|merge({ value: value, rows: 3, maxlength: 2000 })) }}
        {% elseif field.type == 'boolean' %}
            {{ forms.lightswitchField(base|merge({ on: value ? true : false })) }}
        {% elseif field.type == 'number' %}
            {{ forms.textField(base|merge({ value: value, type: 'number', step: 'any' })) }}
        {% elseif field.type == 'select' %}
            {{ forms.selectField(base|merge({
                value: value,
                options: [{ label: "None"|t('menu-builder'), value: '' }]
                    |merge(field.options|map(option => { label: option, value: option })|values),
            })) }}
        {% elseif field.type == 'asset' %}
            {{ forms.elementSelectField(base|merge({
                elementType: 'craft\\elements\\Asset',
                sources: '*',
                single: true,
                limit: 1,
                elements: customAssetElement ? [customAssetElement] : [],
            })) }}
        {% elseif field.type == 'url' %}
            {{ forms.textField(base|merge({ value: value, maxlength: 2000 })) }}
        {% else %}
            {{ forms.textField(base|merge({ value: value, maxlength: 255 })) }}
        {% endif %}
    {% endfor %}

    {# Custom field values share the `metadata` attribute with the mega-menu
       and dynamic-source config, so their validation errors land there. #}
    {% for error in item.getErrors('metadata') %}
        <p class="error">{{ error }}</p>
    {% endfor %}
</div>
{% endif %}

<div data-mb-section="advanced" data-mb-description="{{ "Set technical identifiers and custom HTML attributes."|t('menu-builder') }}">
    <h2>{{ "Advanced"|t('menu-builder') }}</h2>
    {{ forms.textField({ label: "Handle"|t('menu-builder'), instructions: "Used for anchor links and CSS targeting.", id: 'handle', name: 'handle', value: item.handle, errors: item.getErrors('handle') }) }}
    {{ forms.textField({ label: "HTML id"|t('menu-builder'), id: 'htmlId', name: 'htmlId', value: item.htmlId }) }}
    {{ forms.textField({ label: "rel"|t('menu-builder'), instructions: "Additional rel values beyond nofollow/sponsored above.", id: 'rel', name: 'rel', value: item.rel }) }}
    {{ forms.textareaField({
        label: "HTML attributes"|t('menu-builder'),
        instructions: "One `key: value` pair per line, e.g. `data-tracking: nav-main`."|t('menu-builder'),
        id: 'htmlAttributes',
        name: 'htmlAttributes',
        value: item.htmlAttributes|map((v, k) => k ~ ': ' ~ v)|join("\n"),
        errors: item.getErrors('htmlAttributes'),
        rows: 3,
    }) }}
</div>
{% endif %}
</fieldset>
</div>

{% js %}
(function() {
    if (window.MenuBuilder && typeof window.MenuBuilder.initItemFields === 'function') {
        window.MenuBuilder.initItemFields(document.querySelector('[data-menu-builder-item-fields]'));
    }
})();
{% endjs %}
