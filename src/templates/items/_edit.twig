{% extends "_layouts/cp" %}

{% set title = isNew ? "New menu item"|t('menu-builder') : item.title %}
{% set fullPageForm = true %}
{% set crumbs = [
    { label: "MenuBuilder"|t('menu-builder'), url: url('menu-builder') },
    { label: group.name, url: url('menu-builder/' ~ group.handle) },
] %}

{% block actionButton %}
    <div class="btngroup">
        <input type="submit" class="btn submit" value="{{ 'Save'|t('app') }}">
    </div>
{% endblock %}

{% block content %}
    {% include "menu-builder/items/_fields" %}

    {% if not isNew %}
        <hr>
        <form method="post" action="" onsubmit="return confirm('{{ 'Delete “{title}”? This also deletes any child menu items. This cannot be undone.'|t('menu-builder', { title: item.title })|e('js') }}');">
            {{ csrfInput() }}
            <input type="hidden" name="action" value="menu-builder/items/delete">
            <input type="hidden" name="id" value="{{ item.id }}">
            <input type="hidden" name="redirect" value="menu-builder/{{ group.handle }}">
            <button type="submit" class="btn delete">{{ "Delete menu item"|t('app') }}</button>
        </form>
    {% endif %}
{% endblock %}

{% do view.registerAssetBundle("Tahadudhiya\\MenuBuilder\\web\\assets\\cp\\CpAsset") %}
