{% set typeLabels = {
    entry: 'Entry'|t('menu-builder'),
    category: 'Category'|t('menu-builder'),
    asset: 'Asset'|t('menu-builder'),
    url: 'Custom Link'|t('menu-builder'),
    anchor: 'Anchor'|t('menu-builder'),
    nonclickable: 'Heading'|t('menu-builder'),
    separator: 'Separator'|t('menu-builder'),
    dynamic: 'Dynamic'|t('menu-builder'),
} %}

{% for item in items %}
    <li class="menu-builder-item{{ item.enabled ? '' : ' menu-builder-item-disabled' }}{{ item.hasChildren() ? ' menu-builder-item-has-children' : '' }}{{ loop.last ? ' menu-builder-item-last' : '' }}" data-id="{{ item.id }}" data-level="{{ level }}" data-parent-id="{{ parentId ?? '' }}" data-child-count="{{ item.children|length }}" data-no-children="{{ item.type == 'separator' ? '1' : '0' }}" style="--mb-level: {{ level }}">
        <div class="menu-builder-item-row">
            {% if canEdit %}
                <label class="menu-builder-bulk-checkbox">
                    <input type="checkbox" data-mb-bulk-select data-id="{{ item.id }}" aria-label="{{ 'Select {title}'|t('menu-builder', { title: item.title|default('untitled'|t('menu-builder')) }) }}">
                </label>
                <a class="menu-builder-drag-handle move icon" title="{{ 'Reorder'|t('app') }}" role="button" tabindex="0" aria-label="{{ 'Reorder {title}'|t('menu-builder', { title: item.title }) }}"></a>
            {% endif %}

            <span class="menu-builder-item-title">
                {% if item.title %}
                    {{ item.title }}
                {% elseif item.type in ['entry', 'category', 'asset'] %}
                    <em class="light">{{ "(uses linked element's title)"|t('menu-builder') }}</em>
                {% else %}
                    <em class="light">{{ "(untitled)"|t('menu-builder') }}</em>
                {% endif %}
            </span>

            <span class="menu-builder-item-type badge">{{ typeLabels[item.type] ?? item.type }}</span>

            {% if item.metadata.megaMenu.enabled ?? false %}
                <span class="menu-builder-item-status badge" title="{{ 'This item presents its children as a mega menu.'|t('menu-builder') }}">{{ "Mega menu"|t('menu-builder') }}</span>
            {% endif %}

            {% if not item.enabled %}
                {# The `-disabled-flag` class is this badge's own hook: `-item-status`
                   is shared with the mega-menu and orphaned-element badges, so the
                   JS that adds/removes this one on toggle needs a selector that
                   can't collide with them (see tree.js `toggle()`). #}
                <span class="menu-builder-item-status menu-builder-item-disabled-flag badge disabled-badge">{{ "Disabled"|t('menu-builder') }}</span>
            {% endif %}

            {% if orphanedItemIds is defined and orphanedItemIds[item.id] is defined %}
                <span class="menu-builder-item-status badge disabled-badge" title="{{ 'The linked entry/category/asset no longer exists.'|t('menu-builder') }}">
                    ⚠ {{ "Linked element unavailable"|t('menu-builder') }}
                </span>
            {% endif %}

            {% if item.hasChildren() %}
                <span class="menu-builder-item-childcount light" title="{{ '{count} child items'|t('menu-builder', { count: item.children|length }) }}">
                    {{ item.children|length }}
                </span>
            {% endif %}

            {% if canEdit %}
                <div class="menu-builder-item-actions">
                    <button type="button" class="btn small settings icon menubtn" title="{{ 'Actions'|t('menu-builder') }}" aria-label="{{ 'Actions for {title}'|t('menu-builder', { title: item.title|default('untitled'|t('menu-builder')) }) }}"></button>
                    <div class="menu">
                        <ul>
                            <li>
                                <a data-mb-action="edit" data-id="{{ item.id }}" role="button">{{ "Edit"|t('app') }}</a>
                            </li>
                            <li>
                                <a data-mb-action="duplicate" data-id="{{ item.id }}" role="button">{{ "Duplicate"|t('menu-builder') }}</a>
                            </li>
                        </ul>
                        <hr>
                        <ul>
                            <li>
                                <a data-mb-action="toggle" data-id="{{ item.id }}" role="button">
                                    {{ item.enabled ? "Disable"|t('menu-builder') : "Enable"|t('menu-builder') }}
                                </a>
                            </li>
                            <li>
                                <a data-mb-action="delete" data-id="{{ item.id }}" data-title="{{ item.title }}" data-has-children="{{ item.hasChildren() ? '1' : '0' }}" class="error" role="button">{{ "Delete"|t('app') }}</a>
                            </li>
                        </ul>
                    </div>
                </div>
            {% endif %}
        </div>
    </li>

    {% if item.hasChildren() %}
        {% include "menu-builder/dashboard/_items" with { items: item.children, level: level + 1, parentId: item.id, group: group, canEdit: canEdit, orphanedItemIds: orphanedItemIds } %}
    {% endif %}
{% endfor %}
