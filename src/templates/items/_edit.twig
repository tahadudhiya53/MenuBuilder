{% extends "_layouts/cp" %}

{# Resolved by MenuBuilderLabelHelper in ItemsController, so this heading, the tree row and the
   quick-add parent picker all name the item identically — including naming an item with no title
   of its own after the element it links to. #}
{% set itemLabel = itemLabel ?? "(untitled)"|t('menubuilder') %}
{% set title = isNew ? "New menu item"|t('menubuilder') : itemLabel %}

{#
   Read-only when the viewer may look but not save: `items/edit` needs only `view`, and this route
   is deep-linkable, so it has to render without offering a Save the save action would refuse.
#}
{% set fullPageForm = canEdit %}
{% set crumbs = [
    { label: "Menus"|t('menubuilder'), url: url('menubuilder') },
    { label: group.name, url: url('menubuilder/' ~ group.handle) },
] %}

{# Delete lives in the action-button menu rather than in a <form> of its own. #}
{% set formActions = canDelete and not isNew ? [
    {
        label: "Delete menu item"|t('menubuilder'),
        action: 'menubuilder/items/delete',
        params: { id: item.id },
        redirect: ('menubuilder/' ~ group.handle)|hash,
        confirm: 'Delete “{title}”? This also deletes any child menu items. This cannot be undone.'|t('menubuilder', { title: itemLabel }),
        destructive: true,
    },
] : null %}

{% if not canEdit %}
    {% set contentNotice = "You have read-only access to this menu item."|t('menubuilder') %}
{% endif %}

{% block content %}
    {% include "menubuilder/items/_fields" %}
{% endblock %}

{% do view.registerAssetBundle("Tahadudhiya\\MenuBuilder\\web\\assets\\cp\\CpAsset") %}
