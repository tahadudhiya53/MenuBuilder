{% import "_includes/forms" as forms %}
{% import "menubuilder/_macros/cp" as cp %}

{% set megaMenuConfig = item.metadata.megaMenu ?? [] %}
{% set badgeStyleOptions = [
    { label: "Default"|t('menubuilder'), value: 'default' },
    { label: "Info"|t('menubuilder'), value: 'info' },
    { label: "Success"|t('menubuilder'), value: 'success' },
    { label: "Warning"|t('menubuilder'), value: 'warning' },
    { label: "Critical"|t('menubuilder'), value: 'critical' },
] %}
{% set dynamicSource = item.metadata.dynamicSource ?? [] %}
{% set mobileConfig = item.mobileConfig() %}

{% set loggedInRule = item.visibility|filter(r => r.type == 'loggedIn')|first ?: null %}
{% set loggedOutRule = item.visibility|filter(r => r.type == 'loggedOut')|first ?: null %}
{% set userGroupRule = item.visibility|filter(r => r.type == 'userGroup')|first ?: null %}
{% set siteRule = item.visibility|filter(r => r.type == 'site')|first ?: null %}
{% set dateRule = item.visibility|filter(r => r.type == 'dateRange')|first ?: null %}
{% set envRule = item.visibility|filter(r => r.type == 'environment')|first ?: null %}

{% set entryElement = item.type == 'entry' and item.elementId ? craft.entries.id(item.elementId).status(null).one() : null %}
{% set categoryElement = item.type == 'category' and item.elementId ? craft.categories.id(item.elementId).status(null).one() : null %}
{% set assetElement = item.type == 'asset' and item.elementId ? craft.assets.id(item.elementId).one() : null %}
{% set imageElement = item.image ? craft.assets.id(item.image).one() : null %}
{% set iconType = item.iconType() %}
{% set iconAssetElement = item.iconAssetId() ? craft.assets.id(item.iconAssetId()).one() : null %}

<div class="menu-builder-item-fields" data-menu-builder-item-fields>
<input type="hidden" name="action" value="menubuilder/items/save">
<input type="hidden" name="itemId" value="{{ item.id }}">
<input type="hidden" name="groupId" value="{{ group.id }}">
<input type="hidden" name="parentId" value="{{ item.parentId }}">
{{ redirectInput('menubuilder/' ~ group.handle) }}
{{ csrfInput() }}

{# `items/edit` needs only `view`, so this partial can be rendered for someone who may not save. #}
<fieldset class="menu-builder-fieldset"{{ (canEdit ?? true) ? '' : ' disabled' }}>

{# Link health for this item, computed by ItemsController from MenuBuilderLinkHealthService. #}
{% if health is defined and health and not health.isHealthy() %}
    <div class="menu-builder-notice warning menu-builder-health-notice" role="status">
        <p><strong>{{ health.label() }}</strong> — {{ health.message() }}</p>
        <p class="light">{{ health.consequence() }}</p>
        {% if health.needsElementRecovery() %}
            {#
               Four safe ways out, none of which this screen takes on the editor's behalf:
               MenuBuilder never discards a menu item because the thing it pointed at went away.
            #}
            <ul class="menu-builder-health-actions">
                <li>{{ "Pick different content below to relink this item."|t('menubuilder') }}</li>
                <li>{{ "Or set the fallback behaviour to a fallback URL, so it keeps working."|t('menubuilder') }}</li>
                <li>{{ "Or disable this item, so it stops rendering without being lost."|t('menubuilder') }}</li>
                <li>{{ "Or delete it from the menu — that one can’t be undone."|t('menubuilder') }}</li>
            </ul>
        {% endif %}
    </div>
{% endif %}

<div data-mb-section="basic" data-mb-description="{{ "Choose what this item links to and the label shown in the menu."|t('menubuilder') }}">
    <h2>{{ "Basic"|t('menubuilder') }}</h2>

    {{ cp.linkTypeField("Link type"|t('menubuilder'), 'type', item.type) }}

    {{ forms.textField({
        label: "Title"|t('menubuilder'),
        instructions: item.type in ['entry', 'category', 'asset'] ? "Leave blank to use the linked element's own title — required if the item stays visible when that element becomes unavailable."|t('menubuilder') : null,
        id: 'title',
        name: 'title',
        value: item.title,
        errors: item.getErrors('title'),
    }) }}

    <div data-link-section="entry" class="menu-builder-link-section">
        {{ cp.elementPickerField("Entry"|t('menubuilder'), 'entryElementId', 'craft\\elements\\Entry', entryElement ? [entryElement] : [], item.getErrors('elementId')) }}
    </div>

    <div data-link-section="category" class="menu-builder-link-section">
        {{ cp.elementPickerField("Category"|t('menubuilder'), 'categoryElementId', 'craft\\elements\\Category', categoryElement ? [categoryElement] : []) }}
    </div>

    <div data-link-section="asset" class="menu-builder-link-section">
        {{ cp.elementPickerField("Asset"|t('menubuilder'), 'assetElementId', 'craft\\elements\\Asset', assetElement ? [assetElement] : []) }}
    </div>

    <div data-link-section="url" class="menu-builder-link-section">
        {{ forms.textField({
            label: "URL"|t('menubuilder'),
            instructions: "Absolute URLs, root-relative paths, #fragments, mailto:, and tel: links are all accepted."|t('menubuilder'),
            id: 'customUrl',
            name: 'customUrl',
            value: item.customUrl,
            errors: item.getErrors('customUrl'),
        }) }}
    </div>

    <div data-link-section="anchor" class="menu-builder-link-section">
        {{ forms.textField({
            label: "Anchor handle"|t('menubuilder'),
            instructions: "Rendered as a link to #handle. Leave blank to reuse the Handle field in Advanced."|t('menubuilder'),
            id: 'anchorUrl',
            name: 'customUrl',
            value: item.customUrl,
            errors: item.getErrors('handle'),
        }) }}
    </div>

    <div data-link-section="dynamic" class="menu-builder-link-section">
        {{ cp.dynamicSourceTypeField('dynamicSourceType', dynamicSource.sourceType ?? 'entries') }}
        {# One picker per source type, all posting the same `dynamicSourceId`
           the controller already reads — item-fields.js shows the one that
           matches and disables the rest, exactly as the link-type sections
           work, so a hidden picker's value can never be submitted.

           This used to be a bare number field asking the editor to go and
           look an internal ID up under Settings first. Nothing about the
           stored value changed. #}
        {{ cp.dynamicSourcePickers({
            entries: 'dynamicSourceIdEntries',
            categories: 'dynamicSourceIdCategories',
            assets: 'dynamicSourceIdAssets',
        }, dynamicSource.sourceId ?? '', null, true) }}
        {# Blank means "no limit stored", which
           MenuBuilderDynamicNavigationService::normalizeConfig() reads as the
           maximum — that is the state a quick-added dynamic item starts in, so
           showing a made-up 10 here would report a value the item doesn't have.
           The cap comes from MenuBuilderItem::DYNAMIC_SOURCE_MAX_LIMIT rather
           than being written out again. #}
        {{ forms.textField({
            label: "Limit"|t('menubuilder'),
            instructions: "How many children to pull in. Leave blank for the maximum ({max}), which is enforced server-side regardless of what's entered here."|t('menubuilder', { max: dynamicSourceMaxLimit }),
            id: 'dynamicSourceLimit',
            name: 'dynamicSourceLimit',
            type: 'number',
            min: 1,
            max: dynamicSourceMaxLimit,
            value: dynamicSource.limit ?? '',
        }) }}
        {{ forms.selectField({
            label: "Order by"|t('menubuilder'),
            id: 'dynamicSourceOrderBy',
            name: 'dynamicSourceOrderBy',
            value: dynamicSource.orderBy ?? 'dateCreated desc',
            options: [
                { label: "Newest first"|t('menubuilder'), value: 'dateCreated desc' },
                { label: "Oldest first"|t('menubuilder'), value: 'dateCreated asc' },
                { label: "Title (A-Z)"|t('menubuilder'), value: 'title asc' },
                { label: "Title (Z-A)"|t('menubuilder'), value: 'title desc' },
            ],
        }) }}
    </div>

    {#
       Non-clickable headings and separators can never carry a link — no UI exposes one, and
       isLinkable() is authoritative regardless.
    #}
    <input type="hidden" name="clickable" id="clickableField" value="{{ item.type not in ['nonclickable', 'separator'] ? '1' : '' }}">

    {% if isNew %}
        <p class="light">{{ "Behavior, appearance, accessibility, visibility, mobile, and advanced settings become available once this menu item is saved."|t('menubuilder') }}</p>
    {% endif %}
</div>

{% if not isNew %}
<div data-mb-section="behavior" data-mb-description="{{ "Control availability, link destination, and broken-link fallback."|t('menubuilder') }}">
    <h2>{{ "Behavior"|t('menubuilder') }}</h2>

    {{ forms.lightswitchField({
        label: "Enabled"|t('menubuilder'),
        id: 'enabled',
        name: 'enabled',
        on: item.enabled,
    }) }}

    {#
       Target/rel/fallback only make sense for types that can actually produce a link — never for
       a non-clickable heading or a structural separator.
    #}
    <div data-link-section="entry,category,asset,url,anchor" class="menu-builder-link-section">
        {{ forms.selectField({
            label: "Open in"|t('menubuilder'),
            id: 'target',
            name: 'target',
            value: item.target,
            options: [
                { label: "Same window"|t('menubuilder'), value: '_self' },
                { label: "New tab"|t('menubuilder'), value: '_blank' },
            ],
        }) }}

        {{ forms.checkboxField({
            label: "Add rel=\"nofollow\""|t('menubuilder'),
            id: 'nofollow',
            name: 'nofollow',
            checked: item.rel and 'nofollow' in item.rel|split(' '),
        }) }}

        {{ forms.checkboxField({
            label: "Add rel=\"sponsored\""|t('menubuilder'),
            id: 'sponsored',
            name: 'sponsored',
            checked: item.rel and 'sponsored' in item.rel|split(' '),
        }) }}

        <h3>{{ "If the linked element becomes unavailable"|t('menubuilder') }}</h3>
        {{ forms.selectField({
            label: "Fallback behavior"|t('menubuilder'),
            id: 'fallbackBehavior',
            name: 'fallbackBehavior',
            value: item.fallbackBehavior,
            options: [
                { label: "Hide the menu item"|t('menubuilder'), value: 'hide' },
                { label: "Keep it, but disable the link"|t('menubuilder'), value: 'disableLink' },
                { label: "Use a fallback URL"|t('menubuilder'), value: 'fallbackUrl' },
            ],
        }) }}
        <div data-fallback-url>
            {{ forms.textField({
                label: "Fallback URL"|t('menubuilder'),
                id: 'fallbackUrl',
                name: 'fallbackUrl',
                value: item.fallbackUrl,
                errors: item.getErrors('fallbackUrl'),
            }) }}
        </div>
    </div>
</div>

<div data-mb-section="appearance" data-mb-description="{{ "Add icons, badges, imagery, and styling hooks."|t('menubuilder') }}">
    <h2>{{ "Appearance"|t('menubuilder') }}</h2>
    {{ forms.selectField({
        label: "Icon"|t('menubuilder'),
        instructions: "How this item's icon is stored. Raw SVG markup isn't accepted — upload the SVG and pick it as an asset."|t('menubuilder'),
        id: 'iconSource',
        name: 'iconSource',
        value: iconType,
        options: [
            { label: "None"|t('menubuilder'), value: '' },
            { label: "Icon handle / CSS class"|t('menubuilder'), value: 'class' },
            { label: "Asset"|t('menubuilder'), value: 'asset' },
        ],
    }) }}
    <div data-icon-class>
        {{ forms.textField({
            label: "Icon handle or CSS class"|t('menubuilder'),
            instructions: "Any identifier your templates know how to render — `icon-cart`, `fa fa-cart`, `heroicons/outline/home`."|t('menubuilder'),
            id: 'icon',
            name: 'icon',
            value: iconType == 'asset' ? '' : item.iconClass(),
            errors: item.getErrors('icon'),
        }) }}
    </div>
    <div data-icon-asset>
        {{ forms.elementSelectField({
            label: "Icon asset"|t('menubuilder'),
            instructions: "Rendered as an image, never inlined — an SVG uploaded here can't run script in the page."|t('menubuilder'),
            id: 'iconAsset',
            name: 'iconAsset',
            elementType: 'craft\\elements\\Asset',
            sources: '*',
            single: true,
            limit: 1,
            elements: iconAssetElement ? [iconAssetElement] : [],
        }) }}
    </div>
    {#
       Badge text is free text and is escaped where it renders, so no character is rejected here;
       the style beside it is a closed enum because that half reaches a class attribute.
    #}
    {{ forms.textField({
        label: "Badge"|t('menubuilder'),
        instructions: "A short flag shown beside the label — NEW, SALE, BETA. Leave blank for no badge."|t('menubuilder'),
        id: 'badge',
        name: 'badge',
        value: item.badge,
        maxlength: 255,
        errors: item.getErrors('badge'),
    }) }}
    {{ forms.selectField({
        label: "Badge style"|t('menubuilder'),
        instructions: "Adds a `menu-builder-badge--<style>` class for your own CSS. Ignored when the badge is blank."|t('menubuilder'),
        id: 'badgeStyle',
        name: 'badgeStyle',
        options: badgeStyleOptions,
        value: item.badgeStyle() ?? 'default',
    }) }}
    {{ forms.textareaField({ label: "Description"|t('menubuilder'), id: 'description', name: 'description', value: item.description, rows: 2 }) }}
    {{ forms.elementSelectField({
        label: "Image"|t('menubuilder'),
        id: 'image',
        name: 'image',
        elementType: 'craft\\elements\\Asset',
        sources: '*',
        criteria: { kind: 'image' },
        single: true,
        limit: 1,
        elements: imageElement ? [imageElement] : [],
    }) }}
    {{ forms.lightswitchField({ label: "Featured"|t('menubuilder'), id: 'featured', name: 'featured', on: item.featured }) }}
    {{ forms.textField({ label: "CSS class"|t('menubuilder'), id: 'cssClass', name: 'cssClass', value: item.cssClass }) }}
</div>

<div data-mb-section="accessibility" data-mb-description="{{ "Provide clearer labels and helpful browser text."|t('menubuilder') }}">
    <h2>{{ "Accessibility"|t('menubuilder') }}</h2>
    {{ forms.textField({ label: "ARIA label"|t('menubuilder'), id: 'ariaLabel', name: 'ariaLabel', value: item.ariaLabel }) }}
    {{ forms.textField({ label: "Title attribute"|t('menubuilder'), id: 'titleAttribute', name: 'titleAttribute', value: item.titleAttribute }) }}
</div>

<div data-mb-section="visibility" data-mb-description="{{ "Choose who can see this item, where, and when."|t('menubuilder') }}">
    <h2>{{ "Visibility"|t('menubuilder') }}</h2>
    <p class="light">{{ "This menu item is shown when ALL of the checked/filled rules below pass. Leave everything blank to always show it. Ticking both logged-in and logged-out can never be satisfied, so the item would be hidden for everyone."|t('menubuilder') }}</p>

    {{ forms.checkboxField({ label: "Only show to logged-in users"|t('menubuilder'), id: 'visibilityLoggedIn', name: 'visibility[loggedIn]', checked: loggedInRule is not null }) }}
    {{ forms.checkboxField({ label: "Only show to logged-out (anonymous) visitors"|t('menubuilder'), id: 'visibilityLoggedOut', name: 'visibility[loggedOut]', checked: loggedOutRule is not null }) }}

    {{ forms.checkboxSelectField({
        label: "Restrict to user groups"|t('menubuilder'),
        id: 'visibilityUserGroups',
        name: 'visibility[userGroups]',
        values: userGroupRule.groupIds ?? [],
        options: craft.app.userGroups.getAllGroups()|map(g => { label: g.name, value: g.id }),
    }) }}

    {% if craft.app.getIsMultiSite() %}
        {{ forms.checkboxSelectField({
            label: "Restrict to sites"|t('menubuilder'),
            id: 'visibilitySites',
            name: 'visibility[sites]',
            values: siteRule.siteIds ?? [],
            options: craft.app.sites.getAllSites()|map(s => { label: s.name, value: s.id }),
        }) }}
    {% endif %}

    {{ forms.textField({ label: "Visible from"|t('menubuilder'), id: 'visibilityDateStart', name: 'visibility[dateStart]', type: 'datetime-local', value: dateRule.start ?? '' }) }}
    {{ forms.textField({ label: "Visible until"|t('menubuilder'), id: 'visibilityDateEnd', name: 'visibility[dateEnd]', type: 'datetime-local', value: dateRule.end ?? '' }) }}
    {# Rules are resolved with `|first ?: null` above: Twig's `first` returns `false`, not `null`, #}
    {# for an empty match, and `false is not null` is true — so without the coalesce this line #}
    {# tried to read `environments` off a bool and blew up the whole edit slideout. #}
    {{ forms.textField({ label: "Restrict to environments"|t('menubuilder'), instructions: "Comma-separated (matches CRAFT_ENVIRONMENT). An unrecognized environment hides the item."|t('menubuilder'), id: 'visibilityEnvironments', name: 'visibility[environments]', value: envRule is not null ? envRule.environments|join(', ') : '' }) }}
</div>

<div data-mb-section="megaMenu" data-mb-description="{{ "Arrange this item's children in a multi-column panel."|t('menubuilder') }}">
    <h2>{{ "Mega Menu"|t('menubuilder') }}</h2>
    <p class="light">{{ "Enable to present this item's children as a mega-menu panel grouped into columns. Each child picks its own column below."|t('menubuilder') }}</p>
    {{ forms.lightswitchField({
        label: "Enable mega menu for this item's children"|t('menubuilder'),
        id: 'megaMenuEnabled',
        name: 'megaMenuEnabled',
        on: megaMenuConfig.enabled ?? false,
    }) }}
    {{ forms.textField({
        label: "Columns"|t('menubuilder'),
        id: 'megaMenuColumns',
        name: 'megaMenuColumns',
        type: 'number',
        min: 1,
        max: 6,
        value: megaMenuConfig.columns ?? 1,
    }) }}
    {{ forms.textField({
        label: "This item's column (under its parent's mega menu)"|t('menubuilder'),
        instructions: "Only meaningful when this item's own parent has mega menu enabled. Columns beyond that parent's column count fall back to the first column."|t('menubuilder'),
        id: 'megaMenuColumn',
        name: 'megaMenuColumn',
        type: 'number',
        min: 1,
        max: 6,
        value: item.metadata.megaMenuColumn ?? '',
    }) }}
</div>

<div data-mb-section="mobile" data-mb-description="{{ "Fine-tune how this item appears on smaller screens."|t('menubuilder') }}">
    <h2>{{ "Mobile"|t('menubuilder') }}</h2>
    <p class="light">{{ "How this item behaves in a small-screen navigation. MenuBuilder decides which items belong to which navigation, in what order, and which branches collapse — your front-end templates decide the breakpoint. No menu is duplicated: this is the same item, presented differently."|t('menubuilder') }}</p>
    {{ forms.selectField({
        label: "Shown on"|t('menubuilder'),
        instructions: "Restrict this item to one navigation. “Desktop only” and “Mobile only” hide it from the other — the item, its link and its children all go with it."|t('menubuilder'),
        id: 'mobileVisibility',
        name: 'mobileVisibility',
        options: [
            { label: "Desktop and mobile"|t('menubuilder'), value: 'both' },
            { label: "Desktop only"|t('menubuilder'), value: 'desktopOnly' },
            { label: "Mobile only"|t('menubuilder'), value: 'mobileOnly' },
        ],
        value: item.mobileVisibility(),
    }) }}
    {{ forms.textField({
        label: "Mobile order"|t('menubuilder'),
        instructions: "Optional. Items with a number are placed in that order among their siblings on mobile; items without one keep the order you dragged them into and follow after. Only applies where the mobile navigation is rendered separately."|t('menubuilder'),
        id: 'mobileOrder',
        name: 'mobileOrder',
        type: 'number',
        min: 0,
        max: 9999,
        value: mobileConfig.order ?? '',
    }) }}
    {{ forms.selectField({
        label: "Children on mobile"|t('menubuilder'),
        instructions: "By default a branch collapses behind a disclosure on mobile, so a deep menu still fits a phone. “Always expanded” renders its children in place instead. Items with no children are unaffected."|t('menubuilder'),
        id: 'mobileCollapsible',
        name: 'mobileCollapsible',
        options: [
            { label: "Collapsed by default"|t('menubuilder'), value: '' },
            { label: "Always expanded"|t('menubuilder'), value: '0' },
        ],
        value: (mobileConfig.collapsible ?? null) is same as(false) ? '0' : '',
    }) }}
    {{ forms.selectField({
        label: "Mega menu on mobile"|t('menubuilder'),
        instructions: "Only meaningful when this item has mega menu enabled above. Stacking is almost always right on a phone; hiding removes those links from the mobile navigation entirely, so make sure this item links somewhere that reaches them."|t('menubuilder'),
        id: 'mobileMegaMenu',
        name: 'mobileMegaMenu',
        options: [
            { label: "Stack the columns"|t('menubuilder'), value: 'stack' },
            { label: "Keep the columns"|t('menubuilder'), value: 'columns' },
            { label: "Hide the panel"|t('menubuilder'), value: 'hide' },
        ],
        value: item.mobileMegaMenuBehavior(),
    }) }}
</div>

{% if group.hasCustomFields() and item.content is not null %}
{# This menu's Craft field layout, rendered by Craft itself. #}
{% set fieldLayoutForm = item.content.fieldLayout.createForm(item.content, not canEdit) %}

{% for tab in fieldLayoutForm.tabs %}
    {# Two nested elements on purpose. #}
    <div data-mb-section="fields-{{ loop.index }}" data-mb-description="{{ "Set the custom fields configured for this menu."|t('menubuilder') }}">
        <h2>{{ tab.name }}</h2>
        <div id="{{ tab.getId() }}"
             class="flex-fields"
             data-id="{{ tab.getId() }}"
             data-layout-tab="{{ tab.getUid() ?? 1 }}">
            {{ tab.content|raw }}
        </div>
    </div>
{% endfor %}

{# Errors raised against the content element as a whole. #}
{% for attribute, errors in item.getErrors() %}
    {% if attribute starts with 'fields.' %}
        {% for error in errors %}
            <p class="error">{{ error }}</p>
        {% endfor %}
    {% endif %}
{% endfor %}
{% endif %}

<div data-mb-section="advanced" data-mb-description="{{ "Set technical identifiers and custom HTML attributes."|t('menubuilder') }}">
    <h2>{{ "Advanced"|t('menubuilder') }}</h2>
    {{ forms.textField({ label: "Handle"|t('menubuilder'), instructions: "Used for anchor links and CSS targeting.", id: 'handle', name: 'handle', value: item.handle, errors: item.getErrors('handle') }) }}
    {{ forms.textField({ label: "HTML id"|t('menubuilder'), id: 'htmlId', name: 'htmlId', value: item.htmlId }) }}
    {{ forms.textField({ label: "rel"|t('menubuilder'), instructions: "Additional rel values beyond nofollow/sponsored above.", id: 'rel', name: 'rel', value: item.rel }) }}
    {{ forms.textareaField({
        label: "HTML attributes"|t('menubuilder'),
        instructions: "One `key: value` pair per line, e.g. `data-tracking: nav-main`."|t('menubuilder'),
        id: 'htmlAttributes',
        name: 'htmlAttributes',
        value: item.htmlAttributes|map((v, k) => k ~ ': ' ~ v)|join("\n"),
        errors: item.getErrors('htmlAttributes'),
        rows: 3,
    }) }}
</div>
{% endif %}
</fieldset>
</div>

{% js %}
(function() {
    if (window.MenuBuilder && typeof window.MenuBuilder.initItemFields === 'function') {
        window.MenuBuilder.initItemFields(document.querySelector('[data-menu-builder-item-fields]'));
    }
})();
{% endjs %}
